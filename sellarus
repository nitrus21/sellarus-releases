#!/usr/bin/env bash
# Sellarus — day-to-day command for a Docker server (installed by install.sh in /usr/local/bin).
# Several shops can live on the same server: /opt/sellarus/shops/<shop>/ each, behind one shared Caddy
# (/opt/sellarus/proxy/). <shop> may be omitted when the server hosts a single shop.
#   sellarus list                       the shops of this server (name, domain, state)
#   sellarus status [shop]              containers and software version
#   sellarus update [shop] [version]    pull the latest image (or one version, e.g. 0.2.11) and replace the software files;
#                                       settings, uploads, themes and extensions are kept
#   sellarus backup [shop]              database dump + uploads/themes/extensions into shops/<shop>/backups/
#   sellarus logs [shop] [service]      follow the logs (web, db)
#   sellarus restart|stop|start [shop|all]
#   sellarus shell [shop]               a shell inside the web container
#   sellarus domain <shop> [domain]     change the domain of a shop (no domain = HTTP on the server address)
#   sellarus remove <shop> [--purge]    remove a shop (containers, site); --purge also deletes its data volumes
#   sellarus proxy status|logs|reload|restart
#   sellarus migrate                    convert a single-shop installation of the first layout (/opt/sellarus/.env)
set -euo pipefail
DIR=${SELLARUS_HOME:-/opt/sellarus}
PROXY="$DIR/proxy"
SHOPS="$DIR/shops"
IMAGE=ghcr.io/nitrus21/sellarus
BASE_URL="${SELLARUS_BASE_URL:-https://raw.githubusercontent.com/nitrus21/sellarus-releases/main}"
if [ -t 1 ]; then R=$'\033[0m'; B=$'\033[1m'; TEAL=$'\033[38;5;30m'; GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'
else R=''; B=''; TEAL=''; GREEN=''; RED=''; YELLOW=''; DIM=''; fi
say()  { printf '%s\n' "${TEAL}${B}▶${R} $*"; }
ok()   { printf '%s\n' "${GREEN}✔${R} $*"; }
warn() { printf '%s\n' "${YELLOW}▲${R} $*"; }
die()  { printf '%s\n' "${RED}✖${R} $*" >&2; exit 1; }
usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

# ---------- helpers ----------
shops() { [ -d "$SHOPS" ] && for d in "$SHOPS"/*/; do [ -f "$d/.env" ] && basename "$d"; done; return 0; }
shop_env() { ( set -a; . "$SHOPS/$1/.env"; set +a; printf '%s' "${!2:-}" ); }   # shop_env <shop> <VAR>
dcs() { docker compose --project-directory "$SHOPS/$1" "${@:2}"; }                 # compose of one shop
dcp() { docker compose --project-directory "$PROXY" "$@"; }                          # compose of the proxy
legacy() { [ -f "$DIR/.env" ] && [ -f "$DIR/docker-compose.yml" ]; }
fetch() { [ -f "$2" ] || curl -fsSL "$BASE_URL/$1" -o "$2" || die "Could not download $BASE_URL/$1"; }   # fetch <path in the releases repo> <target>

# resolve_shop <name or empty> → sets SHOP; a single shop on the server may be left unnamed
resolve_shop() {
    local list; list=$(shops)
    if [ -n "${1:-}" ]; then
        printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,30}$' || die "Invalid shop name '$1'."
        [ -f "$SHOPS/$1/.env" ] || die "Unknown shop '$1'. Shops of this server: $(printf '%s ' $list)"
        SHOP=$1; return
    fi
    [ -n "$list" ] || { legacy && die "This server still uses the first layout: run 'sellarus migrate' once." ; die "No shop installed in $DIR (run the installation script first)."; }
    [ "$(printf '%s\n' "$list" | wc -l)" = 1 ] || die "Several shops on this server: name one ($(printf '%s ' $list))."
    SHOP=$list
}
version_of() { dcs "$1" exec -T web sh -c "grep -o \"VB_VERSION', '[^']*'\" /var/www/html/app/bootstrap.php | grep -o '[0-9][0-9.]*'" 2>/dev/null | tr -d '\r' || true; }

# write_site <shop> <domain or empty>: the Caddy site file of a shop
write_site() {
    local shop=$1 domain=$2 addr
    mkdir -p "$PROXY/sites"
    if [ -n "$domain" ]; then addr=$domain; else addr=':80'; fi
    cat > "$PROXY/sites/$shop.caddy" <<EOF
# Shop "$shop" — generated by Sellarus (sellarus domain $shop ...). Edit by hand if you know Caddy.
$addr {
	encode zstd gzip
	reverse_proxy sellarus-$shop:80
}
EOF
}
proxy_reload() {
    if [ -n "$(dcp ps -q caddy 2>/dev/null)" ]; then
        dcp exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 && ok "Front (Caddy) reloaded" || { warn "Caddy could not reload its configuration; restarting it"; dcp restart caddy; }
    else
        dcp up -d >/dev/null; ok "Front (Caddy) started"
    fi
}
# another shop already answers on the bare address?
ip_shop() { grep -ls '^:80 {' "$PROXY"/sites/*.caddy 2>/dev/null | head -n1 | xargs -r basename | sed 's/\.caddy$//'; }

cmd=${1:-}; [ -n "$cmd" ] || usage 0
shift || true

case "$cmd" in
    list)
        legacy && ! [ -d "$SHOPS" ] && { warn "First layout detected (single shop in $DIR). Run: sellarus migrate"; exit 0; }
        [ -n "$(shops)" ] || { echo "No shop installed."; exit 0; }
        printf '%s%-18s %-34s %-10s %s%s\n' "$B" "SHOP" "ADDRESS" "STATE" "VERSION" "$R"
        for s in $(shops); do
            d=$(shop_env "$s" DOMAIN); [ -n "$d" ] && url="https://$d" || url="http://<server IP>"
            if [ -n "$(dcs "$s" ps -q web 2>/dev/null)" ]; then state="running"; v=$(version_of "$s"); else state="stopped"; v=""; fi
            printf '%-18s %-34s %-10s %s\n' "$s" "$url" "$state" "${v:-—}"
        done
        ;;
    status)
        resolve_shop "${1:-}"
        say "Shop $SHOP ${DIM}($SHOPS/$SHOP)${R}"; dcs "$SHOP" ps
        echo "${DIM}software version in the volume: $(version_of "$SHOP" || true)${R}"
        say "Front (Caddy)"; dcp ps
        ;;
    update)
        # sellarus update [shop] [version]
        if [ -n "${1:-}" ] && [ -f "$SHOPS/$1/.env" ]; then resolve_shop "$1"; tag=${2:-latest}; else resolve_shop ""; tag=${1:-latest}; fi
        say "Backup of $SHOP first"
        "$0" backup "$SHOP"
        say "Pulling $IMAGE:$tag"
        sed -i "s/^SELLARUS_TAG=.*/SELLARUS_TAG=$tag/" "$SHOPS/$SHOP/.env"
        dcs "$SHOP" pull web
        say "Replacing the software files of $SHOP (settings, images, themes and extensions are kept)"
        dcs "$SHOP" run --rm -e SELLARUS_SYNC=1 web true
        dcs "$SHOP" up -d
        ok "$SHOP updated. Open its back-office once: pending database changes are applied on the first page."
        ;;
    backup)
        resolve_shop "${1:-}"
        mkdir -p "$SHOPS/$SHOP/backups"
        stamp=$(date +%Y%m%d-%H%M%S)
        DB_NAME=$(shop_env "$SHOP" DB_NAME); DB_USER=$(shop_env "$SHOP" DB_USER); DB_PASSWORD=$(shop_env "$SHOP" DB_PASSWORD)
        dcs "$SHOP" exec -T db sh -c "mariadb-dump -u\"$DB_USER\" -p\"$DB_PASSWORD\" --single-transaction \"$DB_NAME\"" > "$SHOPS/$SHOP/backups/db-$stamp.sql"
        dcs "$SHOP" exec -T web sh -c "cd /var/www/html && tar czf - uploads themes extensions config.php 2>/dev/null || tar czf - uploads themes extensions" > "$SHOPS/$SHOP/backups/files-$stamp.tar.gz"
        ok "Backup of $SHOP written: shops/$SHOP/backups/db-$stamp.sql and files-$stamp.tar.gz"
        ;;
    logs)
        if [ -n "${1:-}" ] && [ -f "$SHOPS/$1/.env" ]; then resolve_shop "$1"; shift; else resolve_shop ""; fi
        dcs "$SHOP" logs -f --tail=100 "$@"
        ;;
    restart|stop|start)
        if [ "${1:-}" = all ]; then
            for s in $(shops); do say "$cmd $s"; case "$cmd" in start) dcs "$s" up -d ;; *) dcs "$s" "$cmd" ;; esac; done
            [ "$cmd" = stop ] || dcp up -d; [ "$cmd" = stop ] && dcp stop; ok "Done"
        else
            resolve_shop "${1:-}"
            case "$cmd" in start) dcp up -d >/dev/null; dcs "$SHOP" up -d ;; *) dcs "$SHOP" "$cmd" ;; esac
            ok "$SHOP: $cmd"
        fi
        ;;
    shell) resolve_shop "${1:-}"; dcs "$SHOP" exec web bash ;;
    domain)
        [ -n "${1:-}" ] || die "Usage: sellarus domain <shop> [domain]   (no domain = HTTP on the server address)"
        resolve_shop "$1"; domain=$(printf '%s' "${2:-}" | tr 'A-Z' 'a-z' | sed 's#^https\?://##; s#/.*$##')
        if [ -n "$domain" ]; then printf '%s' "$domain" | grep -Eq '^([a-z0-9-]+\.)+[a-z]{2,}$' || die "'$domain' does not look like a domain name."
        else other=$(ip_shop); [ -z "$other" ] || [ "$other" = "$SHOP" ] || die "Shop '$other' already answers on the bare server address; only one shop can be without a domain."; fi
        sed -i "s/^DOMAIN=.*/DOMAIN=$domain/" "$SHOPS/$SHOP/.env"
        write_site "$SHOP" "$domain"; proxy_reload
        [ -n "$domain" ] && ok "$SHOP now answers on https://$domain (certificate obtained automatically; the domain must point to this server)" || ok "$SHOP now answers on http://<server IP>"
        ;;
    remove)
        [ -n "${1:-}" ] || die "Usage: sellarus remove <shop> [--purge]"
        resolve_shop "$1"; purge=0; [ "${2:-}" = --purge ] && purge=1
        warn "This removes the shop '$SHOP' from this server: its containers and its address."
        [ "$purge" = 1 ] && warn "--purge: its database and files (Docker volumes) will be DELETED too. Make a backup first (sellarus backup $SHOP)."
        printf '%sType the name of the shop to confirm:%s ' "$B" "$R"; read -r answer </dev/tty
        [ "$answer" = "$SHOP" ] || die "Cancelled."
        rm -f "$PROXY/sites/$SHOP.caddy"
        if [ "$purge" = 1 ]; then dcs "$SHOP" down -v; rm -rf "$SHOPS/$SHOP"; ok "Shop $SHOP removed with its data."
        else dcs "$SHOP" down; ok "Shop $SHOP stopped and removed; its data volumes and $SHOPS/$SHOP (settings, backups) are kept."; fi
        if [ -n "$(ls "$PROXY"/sites/*.caddy 2>/dev/null)" ]; then proxy_reload; else dcp stop >/dev/null 2>&1 || true; warn "No shop left: the front (Caddy) is stopped."; fi
        ;;
    proxy)
        case "${1:-status}" in
            status) dcp ps; echo "${DIM}sites:${R}"; ls "$PROXY"/sites/*.caddy 2>/dev/null | xargs -rn1 basename | sed 's/\.caddy$//' ;;
            logs) dcp logs -f --tail=100 caddy ;;
            reload) proxy_reload ;;
            restart) dcp restart; ok "Front restarted" ;;
            *) die "Usage: sellarus proxy status|logs|reload|restart" ;;
        esac
        ;;
    migrate)
        # First layout (one shop in $DIR: docker-compose.yml with its own Caddy) → proxy/ + shops/<shop>/, data kept.
        legacy || die "Nothing to convert: $DIR does not hold a single-shop installation of the first layout."
        [ -z "$(shops)" ] || die "Shops already exist in $SHOPS; convert by hand."
        ( set -a; . "$DIR/.env"; set +a
          [ "${DOMAIN:-}" = ":80" ] && DOMAIN=""
          name=${SELLARUS_SHOP_NAME:-}
          if [ -z "$name" ]; then
              def=$(printf '%s' "${DOMAIN:-boutique}" | cut -d. -f1 | tr -c 'a-z0-9-\n' '-'); [ -n "$def" ] || def=boutique
              printf '%sShort name of this shop%s [%s] ' "$B" "$R" "$def"; read -r name </dev/tty || true; name=${name:-$def}
          fi
          printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9-]{0,30}$' || die "Invalid name '$name' (letters, digits, dashes)."
          say "Converting the shop '$name' (data kept)"
          docker compose --project-directory "$DIR" down >/dev/null 2>&1 || true
          mkdir -p "$PROXY/sites" "$SHOPS/$name" && chmod 700 "$SHOPS/$name"
          # the proxy
          { echo "ACME_EMAIL=${ACME_EMAIL:-admin@localhost}"; echo "HTTP_PORT=${SELLARUS_HTTP_PORT:-80}"; echo "HTTPS_PORT=${SELLARUS_HTTPS_PORT:-443}"; } > "$PROXY/.env"; chmod 600 "$PROXY/.env"
          fetch stack/proxy/docker-compose.yml "$PROXY/docker-compose.yml"; fetch stack/proxy/Caddyfile "$PROXY/Caddyfile"
          # the shop: the compose project keeps its old name ("sellarus") so the existing volumes sellarus_www / sellarus_db are reused
          { echo "SHOP=$name"; echo "COMPOSE_PROJECT_NAME=sellarus"; echo "DOMAIN=${DOMAIN:-}"
            echo "DB_NAME=$DB_NAME"; echo "DB_USER=$DB_USER"; echo "DB_PASSWORD=$DB_PASSWORD"; echo "DB_ROOT_PASSWORD=$DB_ROOT_PASSWORD"
            echo "DB_PREFIX=${DB_PREFIX:-vb_}"; echo "SELLARUS_TAG=${SELLARUS_TAG:-latest}"; } > "$SHOPS/$name/.env"; chmod 600 "$SHOPS/$name/.env"
          fetch stack/shop/docker-compose.yml "$SHOPS/$name/docker-compose.yml"
          [ -d "$DIR/backups" ] && mv "$DIR/backups" "$SHOPS/$name/backups"
          [ -f "$DIR/INSTALLATION.txt" ] && mv "$DIR/INSTALLATION.txt" "$SHOPS/$name/INSTALLATION.txt"
          old="$DIR/old-layout-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$old"; mv "$DIR/.env" "$DIR/docker-compose.yml" "$DIR/Caddyfile" "$old/" 2>/dev/null || true
          docker volume rm sellarus_caddy_data sellarus_caddy_config >/dev/null 2>&1 || true
        ) || exit 1
        name=$(shops)
        write_site "$name" "$(shop_env "$name" DOMAIN)"
        dcp up -d; dcs "$name" up -d
        ok "Converted: shop '$name' in $SHOPS/$name, front in $PROXY. Old files kept in $DIR/old-layout-*."
        ;;
    -h|--help|help) usage 0 ;;
    *) usage ;;
esac
