# Settings of one shop (written by install.sh into /opt/sellarus/shops/<shop>/.env). Keep it private: database passwords.
SHOP=boutique
COMPOSE_PROJECT_NAME=sellarus-boutique
DOMAIN=shop.example.com
DB_NAME=sellarus
DB_USER=sellarus
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_PREFIX=vb_
SELLARUS_TAG=latest
